pipeline {
agent none

    triggers {
        githubPush()
    }
stages {

    stage('Deploy Q2') {
        agent { label 'slave2' }

        steps {
            dir('q2') {
                git branch: '2026Q2', url: 'https://github.com/Rohitbavadekar/Docker2.git'

                sh '''
                docker rm -f Q2 || true
                docker run -d -p 8082:80 --name Q2 httpd
                docker cp index.html Q2:/usr/local/apache2/htdocs/

                '''
            }
        }
    }
}
}
